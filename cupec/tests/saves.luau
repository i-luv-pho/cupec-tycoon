local E=require('../shared/Economy')
local P=require('../shared/SavePolicy')
local count=0
local function check(v,label) assert(v,label);count+=1 end
local old=P.acquire(nil,'server-A',1000)
check(old.cash==450 and old._lease.token=='server-A','new profile gets lease')
check(P.acquire(old,'server-B',1100)==nil,'concurrent server cannot load')
check(P.acquire(old,'server-B',1180)._lease.token=='server-B','stale lease can recover')
local snapshot=E.restore(old)
E.transact(snapshot,'buy','factory')
local saved=P.commit(old,snapshot,'server-A',1040,false)
check(saved.cash==150 and saved._lease.at==1040,'owner saves and renews lease')
check(old.cash==450 and snapshot.cash==150,'save transforms do not mutate arguments')
check(P.commit(saved,snapshot,'server-B',1041,false)==nil,'other server cannot overwrite')
check(P.commit(nil,snapshot,'server-A',1041,false)==nil,'missing store record cannot be overwritten')
local released=P.commit(saved,snapshot,'server-A',1045,true)
check(released._lease==nil and released.cash==150,'leave releases lock and persists cash')
check(P.acquire(released,'server-B',1046).cash==150,'rejoin restores progress')
local newOwner=P.acquire(old,'server-B',1200)
check(P.commit(newOwner,snapshot,'server-A',1201,false)==nil,'old server cannot overwrite after takeover')
check(P.acquire({version=1,cash=0/0},'server-A',1000)==nil,'corrupt record never replaced with new profile')
local corrupt=E.new();corrupt._lease='invalid'
check(P.acquire(corrupt,'server-A',1000)==nil,'malformed lease fails closed')
print('PASS: '..count..' save ownership and rejoin assertions')
