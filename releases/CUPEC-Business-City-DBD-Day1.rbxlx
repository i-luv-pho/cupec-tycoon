      <Item class="ModuleScript" referent="5">
        <Properties>
          <string name="Name">Economy</string>
          <string name="Source"><![CDATA[--!strict
-- Pure domain logic; shared by the authoritative server and CLI tests.
local Config = if script then require(script.Parent.Config) else require('./Config')
local Economy = {}

function Economy.new()
	return { cash = Config.StartCash, earned = 0, invested = 0, businesses = {}, operations = 0, version = 1 }
end

local function finite(n)
	return type(n) == 'number' and n == n and math.abs(n) < math.huge
end

function Economy.definition(id)
	if type(id) ~= 'string' or #id > 32 then return nil end
	for _, def in Config.Businesses do if def.id == id then return def end end
	return nil
end

function Economy.restore(raw)
	if type(raw) ~= 'table' or raw.version ~= 1 then return nil end
	if not finite(raw.cash) or raw.cash < 0 or raw.cash > Config.MaxCash then return nil end
	if not finite(raw.earned) or raw.earned < 0 or raw.earned > Config.MaxCash then return nil end
	if not finite(raw.invested) or raw.invested < 0 or raw.invested > Config.MaxCash then return nil end
	if type(raw.businesses) ~= 'table' then return nil end
	local p = Economy.new()
	p.cash, p.earned, p.invested = raw.cash, raw.earned, raw.invested
	if raw.operations ~= nil then
		if not finite(raw.operations) or raw.operations < 0 or raw.operations % 1 ~= 0 or raw.operations > 1e9 then return nil end
		p.operations = raw.operations
	end
	for id, level in raw.businesses do
		local d = Economy.definition(id)
		if not d or not finite(level) or level % 1 ~= 0 or level < 0 or level > #d.projects then return nil end
		p.businesses[id] = level
	end
	return p
end

function Economy.rate(p, factor)
	local rate = 0
	for _, d in Config.Businesses do
		local level = p.businesses[d.id]
		if level ~= nil then
			rate += d.income
			for i = 1, level do rate += d.projects[i].addIncome end
		end
	end
	-- An integrated factory/depot creates a small operating synergy.
	if p.businesses.factory ~= nil and p.businesses.logistics ~= nil then rate *= 1.15 end
	return rate * factor
end

function Economy.assets(p)
	local assets = 0
	for _, d in Config.Businesses do
		local level = p.businesses[d.id]
		if level ~= nil then
			assets += d.assets
			for i = 1, level do assets += d.projects[i].cost end
		end
	end
	return assets
end

function Economy.transact(p, action, id)
	local d = Economy.definition(id)
	if not d then return false, 'Unknown business.' end
	local level = p.businesses[id]
	if action == 'buy' then
		if level ~= nil then return false, 'You already own this business.' end
		if d.requires and p.businesses[d.requires] == nil then return false, 'Acquire ' .. Economy.definition(d.requires).name .. ' first.' end
		if p.cash < d.cost then return false, 'Earn more cash before acquiring this business.' end
		p.cash -= d.cost
		p.invested += d.cost
		p.businesses[id] = 0
		return true, 'Acquired ' .. d.name .. '!'
	elseif action == 'improve' then
		if level == nil then return false, 'Acquire this business first.' end
		local project = d.projects[level + 1]
		if not project then return false, 'All improvements are complete.' end
		if p.cash < project.cost then return false, 'Earn more cash before funding this improvement.' end
		p.cash -= project.cost
		p.invested += project.cost
		p.businesses[id] = level + 1
		return true, project.name .. ' complete!'
	end
	return false, 'Unknown action.'
end

function Economy.operate(p, id)
	local d = Economy.definition(id)
	if not d or p.businesses[id] == nil then return false, 'Acquire this business before running operations.' end
	local rate = d.income
	for i=1,p.businesses[id] do rate += d.projects[i].addIncome end
	local reward = math.min(rate * Config.OperationSeconds, Config.MaxCash-p.cash, Config.MaxCash-p.earned)
	p.cash += reward
	p.earned += reward
	p.operations = math.min((p.operations or 0)+1,1e9)
	return true, 'Operation completed at '..d.name..'! +$'..math.floor(reward)
end

function Economy.tick(p, seconds, factor)
	if not finite(seconds) or seconds < 0 or seconds > 5 then return 0 end
	if not finite(factor) or factor < 0.5 or factor > 2 then return 0 end
	local earned = math.min(Economy.rate(p, factor) * seconds, Config.MaxCash - p.cash, Config.MaxCash - p.earned)
	p.cash += earned
	p.earned += earned
	return earned
end

return Economy
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="6">
        <Properties>
          <string name="Name">SavePolicy</string>
          <string name="Source"><![CDATA[--!strict
-- Pure UpdateAsync transforms. An expired lease may be acquired on load;
-- a save must still own its exact token and cannot steal another lease.
local E = if script then require(script.Parent.Economy) else require('./Economy')
local Policy = {}
function Policy.acquire(old, token, now)
	local p=if old==nil then E.new() else E.restore(old)
	if not p then return nil end
	if old and old._lease then
		local lease=old._lease
		if type(lease)~='table' or type(lease.token)~='string' or type(lease.at)~='number' or lease.at~=lease.at then return nil end
		if lease.token~=token and now-lease.at<180 then return nil end
	end
	p._lease={token=token,at=now}
	return p
end
function Policy.commit(old, snapshot, token, now, release)
	if type(old)~='table' or type(old._lease)~='table' or old._lease.token~=token then return nil end
	local p=E.restore(snapshot)
	if not p then return nil end
	p._lease=if release then nil else {token=token,at=now}
	return p
end
return Policy
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="7">
        <Properties>
          <string name="Name">Format</string>
          <string name="Source"><![CDATA[--!strict
-- Format — ModuleScript at ReplicatedStorage/Modules/Format
-- Abbreviates big numbers the way idle-game players expect: 1.2K, 3.4M, 5.6aa

local Format = {}

local SHORT = { "", "K", "M", "B", "T", "Qa", "Qi", "Sx", "Sp", "Oc", "No", "Dc" }
local ALPHA = "abcdefghijklmnopqrstuvwxyz"

local function alphaSuffix(tier: number): string
	-- after the named tiers we go aa, ab, ac ... zz (standard incremental notation)
	local n = tier - #SHORT
	local first = math.floor((n - 1) / 26) + 1
	local second = ((n - 1) % 26) + 1
	return ALPHA:sub(first, first) .. ALPHA:sub(second, second)
end

function Format.number(value: number): string
	if value ~= value or value == math.huge then return "∞" end
	local neg = value < 0
	value = math.abs(value)
	if value < 1000 then
		local s = string.format("%.0f", value)
		return (neg and "-" or "") .. s
	end
	local tier = math.floor(math.log(value, 1000))
	local scaled = value / (1000 ^ tier)
	local suffix = SHORT[tier + 1] or alphaSuffix(tier + 1)
	-- 3 significant figures reads best on a phone screen
	local s = if scaled < 10 then string.format("%.2f", scaled)
		elseif scaled < 100 then string.format("%.1f", scaled)
		else string.format("%.0f", scaled)
	return (neg and "-" or "") .. s .. suffix
end

function Format.time(seconds: number): string
	seconds = math.max(0, math.floor(seconds))
	local h = math.floor(seconds / 3600)
	local m = math.floor((seconds % 3600) / 60)
	local s = seconds % 60
	if h > 0 then return string.format("%dh %dm", h, m) end
	if m > 0 then return string.format("%dm %ds", m, s) end
	return string.format("%ds", s)
end

table.freeze(Format)
return Format
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="8">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="9">
      <Properties>
        <string name="Name">CUPEC</string>
      </Properties>
      <Item class="Script" referent="10">
        <Properties>
          <string name="Name">Main</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[--!strict
local Players = game:GetService('Players')
local RS = game:GetService('ReplicatedStorage')
local Config = require(RS.CUPEC.Config)
local Economy = require(RS.CUPEC.Economy)
local Profiles = require(script.Parent.Profiles)
local World = require(script.Parent.World)

local remote = Instance.new('RemoteEvent')
remote.Name, remote.Parent = 'Portfolio', RS.CUPEC
local slots, lastAction, lastSync, saveMode, operationTimes = {}, {}, {}, {}, {}
local marketIndex, nextMarket = 1, os.clock()+Config.MarketSeconds
local shuttingDown=false

local function send(player, message, selected)
	local p=Profiles.data[player]
	if not p or not slots[player] or not player.Parent then return end
	remote:FireClient(player, {
		cash=p.cash, earned=p.earned, invested=p.invested, businesses=table.clone(p.businesses), operations=p.operations or 0,
		rate=Economy.rate(p,Config.Markets[marketIndex].factor), assets=Economy.assets(p),
		market=Config.Markets[marketIndex].name, factor=Config.Markets[marketIndex].factor,
		nextMarket=math.max(0,math.ceil(nextMarket-os.clock())), slot=slots[player],
		message=message, selected=selected, saveMode=saveMode[player],
	})
end

World.build(function(player,index,id)
	if slots[player]~=index then send(player,'This is another player’s portfolio. Your deals are on your own plot.'); return end
	send(player,nil,id)
end,function(player,index,id,terminal)
	if slots[player]~=index or Profiles.closing[player] or not Profiles.data[player] then return end
	local character=player.Character
	local root=character and character:FindFirstChild('HumanoidRootPart')
	if not root or (root.Position-terminal.Position).Magnitude>18 then return end
	local times=operationTimes[player] or {}
	operationTimes[player]=times
	local now=os.clock()
	if now-(times[id] or -1000)<Config.OperationCooldown then
		send(player,'This operation is running. Visit another business or return in '..math.ceil(Config.OperationCooldown-(now-times[id]))..'s.',id);return
	end
	local ok,message=Economy.operate(Profiles.data[player],id)
	if ok then times[id]=now end
	send(player,message,id)
end)

local function join(player)
	local free=nil
	for i,plot in World.plots do if not plot.owner then free=i; break end end
	if not free then player:Kick('This district has four portfolios. Please join another server.'); return end
	slots[player]=free
	World.assign(free,player) -- reserve before the save load yields
	player.CharacterAdded:Connect(function(character)
		character:WaitForChild('HumanoidRootPart',10)
		local humanoid=character:FindFirstChildOfClass('Humanoid');if humanoid then humanoid.WalkSpeed=26 end
		if slots[player] and character.Parent then World.teleport(free,character) end
	end)
	local p,mode=Profiles.load(player)
	if not p then
		if World.plots[free].owner==player then World.release(free) end
		slots[player]=nil
		player:Kick(mode)
		return
	end
	if not player.Parent or shuttingDown then
		Profiles.release(player)
		if World.plots[free].owner==player then World.release(free) end
		slots[player]=nil; return
	end
	saveMode[player]=mode
	World.refresh(free,p)
	if player.Character and player.Character:FindFirstChild('HumanoidRootPart') then World.teleport(free,player.Character) end
	local stats=Instance.new('Folder')
	stats.Name,stats.Parent='leaderstats',player
	local net=Instance.new('IntValue')
	net.Name,net.Parent='Portfolio value',stats
	net.Value=math.floor(p.cash+Economy.assets(p))
	send(player,'Welcome. Acquire '..Config.Businesses[1].name..' to put your first business to work.','factory')
end

remote.OnServerEvent:Connect(function(player,action,id)
	if shuttingDown or Profiles.closing[player] or not Profiles.data[player] then return end
	local now=os.clock()
	if action=='sync' then
		if now-(lastSync[player] or -1)>=0.5 then lastSync[player]=now; send(player) end
		return
	end
	local bucket=lastAction[player] or {at=now,tokens=6}
	bucket.tokens=math.min(6,bucket.tokens+(now-bucket.at)*6)
	bucket.at=now
	lastAction[player]=bucket
	if bucket.tokens<1 then return end
	bucket.tokens-=1
	if type(action)~='string' or (action~='buy' and action~='improve' and action~='travel') then return end
	if type(id)~='string' or #id>32 then return end
	if action=='travel' then
		if Economy.definition(id) and player.Character then World.teleport(slots[player],player.Character,id);send(player,'Arrived at '..Economy.definition(id).name..'. Enter the building and use the operations terminal.') end
		return
	end
	local ok,message=Economy.transact(Profiles.data[player],action,id)
	if ok then World.refresh(slots[player],Profiles.data[player]) end
	send(player,message,id)
end)

Players.PlayerAdded:Connect(function(player) task.spawn(join,player) end)
for _,player in Players:GetPlayers() do task.spawn(join,player) end
Players.PlayerRemoving:Connect(function(player)
	local index=slots[player]
	slots[player],lastAction[player],lastSync[player],saveMode[player],operationTimes[player]=nil,nil,nil,nil,nil
	if index then World.release(index) end
	Profiles.release(player)
end)

task.spawn(function()
	local previous=os.clock()
	while not shuttingDown do
		task.wait(1)
		local now=os.clock()
		local delta=math.min(now-previous,5)
		previous=now
		if now>=nextMarket then
			marketIndex=marketIndex%#Config.Markets+1
			nextMarket=now+Config.MarketSeconds
		end
		for player,p in Profiles.data do
			if not Profiles.closing[player] and slots[player] then
				Economy.tick(p,delta,Config.Markets[marketIndex].factor)
				local stats=player:FindFirstChild('leaderstats')
				if stats then stats['Portfolio value'].Value=math.floor(p.cash+Economy.assets(p)) end
				send(player)
			end
		end
	end
end)

task.spawn(function()
	while not shuttingDown do
		task.wait(45)
		for player in Profiles.data do
			if not Profiles.closing[player] then
				if not Profiles.save(player,false) then
					Profiles.release(player)
					player:Kick('Saving was interrupted. Please rejoin so we can protect your progress.')
				end
			end
		end
	end
end)

game:BindToClose(function()
	shuttingDown=true
	local pending=0
	for player in Profiles.data do
		pending+=1
		task.spawn(function() Profiles.release(player); pending-=1 end)
	end
	local deadline=os.clock()+25
	while pending>0 and os.clock()<deadline do task.wait(0.1) end
end)
print('[CUPEC] Business City ready. Four districts, twelve businesses each, active operations.')
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="11">
        <Properties>
          <string name="Name">Profiles</string>
          <string name="Source"><![CDATA[--!strict
-- Adapted from the upstream DataManager's session-lock / UpdateAsync pattern.
-- Studio previews use memory only. Live servers refuse unavailable/corrupt saves.
local DSS = game:GetService('DataStoreService')
local RunService = game:GetService('RunService')
local HttpService = game:GetService('HttpService')
local E = require(game:GetService('ReplicatedStorage').CUPEC.Economy)
local Policy = require(game:GetService('ReplicatedStorage').CUPEC.SavePolicy)
local Profiles = { data = {}, closing = {}, busy = {} }
local preview = RunService:IsStudio()
local token = HttpService:GenerateGUID(false)
local store = nil
if not preview then
	local ok, result = pcall(function() return DSS:GetDataStore('CUPEC_Acquisitions_v1') end)
	if ok then store = result else warn('[CUPEC] Save store unavailable:', result) end
end

function Profiles.load(player)
	if preview then
		Profiles.data[player] = E.new()
		return Profiles.data[player], 'LOCAL PREVIEW · saves are off'
	end
	if not store then return nil, 'Saving is unavailable. Please try again later.' end
	local ok, raw = pcall(function()
		return store:UpdateAsync('player_' .. player.UserId, function(old)
			return Policy.acquire(old,token,os.time())
		end)
	end)
	if not ok or not raw then return nil, 'Your save is unavailable or active on another server. Please rejoin in a few minutes.' end
	local data = E.restore(raw)
	if not data then return nil, 'Your save could not be read safely.' end
	Profiles.data[player] = data
	return data, 'ONLINE · autosave enabled'
end

function Profiles.save(player, release)
	local deadline = os.clock() + 20
	while Profiles.busy[player] and os.clock() < deadline do task.wait(0.1) end
	if Profiles.busy[player] then return false end
	local data = Profiles.data[player]
	if not data then return true end
	if preview then return true end
	Profiles.busy[player] = true
	local snapshot = E.restore(data)
	local success = false
	for attempt = 1, 3 do
		local ok, result = pcall(function()
			return store:UpdateAsync('player_' .. player.UserId, function(old)
				return Policy.commit(old,snapshot,token,os.time(),release)
			end)
		end)
		if ok and result then success = true; break end
		task.wait(attempt)
	end
	Profiles.busy[player] = nil
	if not success then warn('[CUPEC] Save failed for player', player.UserId) end
	return success
end

function Profiles.release(player)
	if Profiles.closing[player] then return end
	Profiles.closing[player] = true
	Profiles.save(player, true)
	Profiles.data[player] = nil
	Profiles.closing[player] = nil
end

return Profiles
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="12">
        <Properties>
          <string name="Name">World</string>
          <string name="Source"><![CDATA[--!strict
-- Original CUPEC city. No external art, audio, scripts or paid assets.
local Config=require(game:GetService('ReplicatedStorage').CUPEC.Config)
local World={plots={}}
local navy=Color3.fromRGB(23,34,53)
local rose=Color3.fromRGB(226,140,156)
local cream=Color3.fromRGB(244,235,219)
local gold=Color3.fromRGB(222,181,112)
local teal=Color3.fromRGB(75,145,137)
local gray=Color3.fromRGB(103,115,122)
local function part(parent,name,size,pos,color,material)
	local p=Instance.new('Part')
	p.Name,p.Size,p.Position,p.Color=name,size,pos,color
	p.Anchored=true
	p.Material=material or Enum.Material.SmoothPlastic
	p.TopSurface,p.BottomSurface=Enum.SurfaceType.Smooth,Enum.SurfaceType.Smooth
	p.Parent=parent
	return p
end
local function sign(parent,pos,size,text,bg)
	local board=part(parent,'Sign',size,pos,bg or navy)
	local gui=Instance.new('SurfaceGui')
	gui.Face,gui.PixelsPerStud=Enum.NormalId.Front,25
	gui.Parent=board
	local label=Instance.new('TextLabel')
	label.Size,label.BackgroundTransparency=UDim2.fromScale(1,1),1
	label.Font,label.TextColor3=Enum.Font.GothamBold,cream
	label.TextScaled,label.TextWrapped,label.Text=true,true,text
	label.Parent=gui
	local pad=Instance.new('UIPadding')
	pad.PaddingLeft,pad.PaddingRight=UDim.new(0,8),UDim.new(0,8)
	pad.PaddingTop,pad.PaddingBottom=UDim.new(0,5),UDim.new(0,5)
	pad.Parent=label
	return label
end
local function prompt(parent,action,object,callback)
	local p=Instance.new('ProximityPrompt')
	p.ActionText,p.ObjectText=action,object
	p.HoldDuration,p.MaxActivationDistance,p.RequiresLineOfSight=0.35,12,false
	p.Parent=parent
	p.Triggered:Connect(callback)
	return p
end
local function tree(parent,x,z)
	part(parent,'Trunk',Vector3.new(2,9,2),Vector3.new(x,4.5,z),Color3.fromRGB(112,89,67),Enum.Material.Wood)
	local top=part(parent,'Canopy',Vector3.new(12,13,12),Vector3.new(x,14,z),teal)
	top.Shape=Enum.PartType.Ball
end
local function bench(parent,pos)
	part(parent,'Bench',Vector3.new(9,1,3),pos+Vector3.new(0,2,0),gold,Enum.Material.Wood)
	part(parent,'BenchBack',Vector3.new(9,3,0.6),pos+Vector3.new(0,3.5,1.5),gold,Enum.Material.Wood)
	for _,x in {-3,3} do part(parent,'BenchLeg',Vector3.new(1,2,2),pos+Vector3.new(x,1,0),navy,Enum.Material.Metal) end
end
local function light(parent,pos)
	local pole=part(parent,'Streetlight',Vector3.new(0.7,16,0.7),pos+Vector3.new(0,8,0),navy,Enum.Material.Metal)
	local lamp=part(parent,'Lamp',Vector3.new(4,0.5,3),pos+Vector3.new(0,16,0),cream,Enum.Material.Neon)
	local glow=Instance.new('PointLight');glow.Brightness,glow.Range,glow.Color=0.6,26,cream;glow.Parent=lamp
end
local function interior(b,origin,kind,accent)
	local function item(name,size,offset,color,mat) return part(b,name,size,origin+offset,color,mat) end
	if kind=='factory' then
		item('Conveyor',Vector3.new(29,2,7),Vector3.new(0,2,6),navy,Enum.Material.Metal)
		for j=-2,2 do
			item('Roller',Vector3.new(2,0.4,7),Vector3.new(j*5,3.3,6),gray,Enum.Material.Metal)
			item('Product',Vector3.new(3,2,3),Vector3.new(j*5,4.5,6),accent)
		end
		for _,x in {-17,17} do item('Press',Vector3.new(6,10,9),Vector3.new(x,6,8),teal,Enum.Material.Metal) end
		item('Chimney',Vector3.new(4,15,4),Vector3.new(17,25,15),navy,Enum.Material.Metal)
	elseif kind=='depot' then
		for z=1,2 do for x=-2,2 do item('Cargo',Vector3.new(7,5,6),Vector3.new(x*8,3,(z-1)*9+4),if z==1 then accent else teal) end end
		item('DeliveryTruck',Vector3.new(12,7,20),Vector3.new(28,4,24),cream)
		item('TruckCab',Vector3.new(12,6,7),Vector3.new(28,4,11),accent)
		for _,x in {22,34} do for _,z in {14,30} do local tire=item('Wheel',Vector3.new(2,5,5),Vector3.new(x,2.5,z),navy);tire.Shape=Enum.PartType.Cylinder end end
	elseif kind=='cafe' then
		item('CoffeeBar',Vector3.new(32,5,5),Vector3.new(0,3,11),gold,Enum.Material.Wood)
		item('EspressoMachine',Vector3.new(7,4,4),Vector3.new(-8,7,11),gray,Enum.Material.Metal)
		for _,x in {-14,12} do
			item('Table',Vector3.new(8,1,8),Vector3.new(x,3,-4),rose)
			for _,dx in {-5,5} do item('Seat',Vector3.new(3,2,3),Vector3.new(x+dx,1.5,-4),teal) end
		end
	elseif kind=='retail' then
		for _,x in {-15,0,15} do
			item('Shelf',Vector3.new(8,8,2),Vector3.new(x,5,8),gold,Enum.Material.Wood)
			for j=1,3 do item('Stock',Vector3.new(6,1.5,3),Vector3.new(x,j*2.3,6.5),if j%2==0 then rose else teal) end
		end
	elseif kind=='energy' then
		for _,x in {-15,0,15} do
			local panel=item('SolarPanel',Vector3.new(12,0.7,14),Vector3.new(x,9,7),Color3.fromRGB(42,75,130),Enum.Material.Glass)
			panel.Orientation=Vector3.new(-18,0,0)
			item('PanelStand',Vector3.new(2,8,2),Vector3.new(x,4,7),gray,Enum.Material.Metal)
			item('Battery',Vector3.new(6,5,4),Vector3.new(x,3,-5),teal)
		end
	elseif kind=='hotel' then
		item('Reception',Vector3.new(20,4,5),Vector3.new(10,2.5,6),gold,Enum.Material.Wood)
		item('LoungeSofa',Vector3.new(14,3,6),Vector3.new(-13,2,7),rose)
		for i=1,3 do item('UpperFloor',Vector3.new(52,7,32),Vector3.new(0,21+i*7,2),cream);item('WindowBand',Vector3.new(48,3,0.4),Vector3.new(0,21+i*7,-14.2),teal,Enum.Material.Glass) end
	elseif kind=='clinic' then
		for _,x in {-15,0,15} do item('ConsultingDesk',Vector3.new(9,3,6),Vector3.new(x,2,6),cream);item('Monitor',Vector3.new(4,3,0.5),Vector3.new(x,5,6),teal) end
		item('Reception',Vector3.new(24,4,3),Vector3.new(0,2.5,-7),rose)
	else
		for _,x in {-15,0,15} do
			item('Desk',Vector3.new(10,1,7),Vector3.new(x,4,6),gold,Enum.Material.Wood)
			item('DeskBase',Vector3.new(2,4,4),Vector3.new(x,2,6),navy)
			item('Screen',Vector3.new(6,4,0.5),Vector3.new(x,6.5,7),teal,Enum.Material.Neon)
		end
		if kind=='office' then item('OfficeTower',Vector3.new(30,23,18),Vector3.new(0,31,10),accent) end
	end
end
function World.build(onPrompt,onOperation)
	local previous=workspace:FindFirstChild('CUPECDistrict');if previous then previous:Destroy() end
	World.plots={}
	local root=Instance.new('Folder');root.Name,root.Parent='CUPECDistrict',workspace
	part(root,'CityGround',Vector3.new(900,4,800),Vector3.new(0,-2,0),Color3.fromRGB(164,186,164),Enum.Material.Grass)
	part(root,'NorthSouthAvenue',Vector3.new(42,0.3,760),Vector3.new(0,0.2,0),navy,Enum.Material.Asphalt)
	part(root,'EastWestAvenue',Vector3.new(860,0.3,42),Vector3.new(0,0.25,0),navy,Enum.Material.Asphalt)
	for x=-420,420,24 do part(root,'RoadMark',Vector3.new(10,0.1,0.7),Vector3.new(x,0.45,0),gold) end
	for z=-370,370,24 do part(root,'RoadMark',Vector3.new(0.7,0.1,10),Vector3.new(0,0.45,z),gold) end
	local plaza=part(root,'CUPECPlaza',Vector3.new(90,0.6,55),Vector3.new(0,0.4,-52),cream)
	local fountain=part(root,'Fountain',Vector3.new(16,2,16),Vector3.new(0,1.7,-52),teal,Enum.Material.Glass);fountain.Shape=Enum.PartType.Cylinder;fountain.Orientation=Vector3.new(0,0,90)
	sign(root,Vector3.new(0,19,-81),Vector3.new(70,12,2),'CUPEC\nBUSINESS CITY',navy)
	sign(root,Vector3.new(0,10,-81),Vector3.new(70,5,1),'BUY ASSET VALUE. BUILD GLOBAL REACH.',rose)
	for _,x in {-34,34} do bench(root,Vector3.new(x,0,-55)) end
	for x=-400,400,80 do tree(root,x,-385);tree(root,x,385);light(root,Vector3.new(x,0,27));light(root,Vector3.new(x,0,-27)) end
	for z=-320,320,80 do light(root,Vector3.new(27,0,z));light(root,Vector3.new(-27,0,z)) end
	for index,center in {Vector3.new(-225,0,-195),Vector3.new(225,0,-195),Vector3.new(-225,0,195),Vector3.new(225,0,195)} do
		local model=Instance.new('Model');model.Name,model.Parent='Portfolio'..index,root
		part(model,'DistrictPaving',Vector3.new(390,0.5,310),center+Vector3.new(0,0.5,0),Color3.fromRGB(213,211,200),Enum.Material.Concrete)
		local ownerLabel=sign(model,center+Vector3.new(0,8,-148),Vector3.new(94,10,1),'DISTRICT '..index..' · AVAILABLE',navy)
		local spawn=Instance.new('SpawnLocation');spawn.Name,spawn.Size,spawn.Anchored='PortfolioSpawn',Vector3.new(6,1,6),true
		spawn.CFrame=CFrame.lookAt(center+Vector3.new(0,1.1,-130),center+Vector3.new(0,1.1,0));spawn.Transparency,spawn.Neutral,spawn.Duration=1,true,0;spawn.Parent=model
		local plot={model=model,label=ownerLabel,origin=center,spawn=spawn,buildings={},owner=nil};World.plots[index]=plot
		for row=0,2 do
			local z=-98+row*96
			part(model,'LocalStreet',Vector3.new(380,0.25,18),center+Vector3.new(0,0.85,z-29),navy,Enum.Material.Asphalt)
			for x=-170,170,25 do part(model,'StreetMark',Vector3.new(8,0.1,0.4),center+Vector3.new(x,1,z-29),cream) end
		end
		for i,d in Config.Businesses do
			local col=(i-1)%4;local row=math.floor((i-1)/4)
			local origin=center+Vector3.new(-138+col*92,0,-98+row*96)
			local b=Instance.new('Model');b.Name,b.Parent=d.id,model
			local accent=({rose,teal,gold,Color3.fromRGB(121,151,187)})[col+1]
			part(b,'Floor',Vector3.new(58,1,44),origin+Vector3.new(0,1,3),cream,Enum.Material.Concrete)
			local wall=part(b,'BackWall',Vector3.new(56,17,1),origin+Vector3.new(0,9.5,24),cream)
			for _,x in {-28,28} do part(b,'SideWall',Vector3.new(1,17,44),origin+Vector3.new(x,9.5,3),cream) end
			-- Open shopfront and rear canopy keep interiors visible and walkable.
			part(b,'Canopy',Vector3.new(60,1.5,18),origin+Vector3.new(0,19,16),accent)
			part(b,'ShopHeader',Vector3.new(60,3,2),origin+Vector3.new(0,18,-19),accent)
			for _,x in {-27,27} do part(b,'FrontPillar',Vector3.new(2,17,2),origin+Vector3.new(x,9.5,-18),navy) end
			interior(b,origin,d.kind or 'office',accent)
			sign(b,origin+Vector3.new(0,23,-19),Vector3.new(57,6,1),d.name,navy)
			local status=sign(b,origin+Vector3.new(0,4,-21),Vector3.new(40,5,1),'FOR SALE · $'..d.cost,navy)
			status.Parent.Parent.CanCollide=false
			local desk=part(b,'DealDesk',Vector3.new(8,0.5,5),origin+Vector3.new(-20,1.8,-17),accent,Enum.Material.Neon)
			local inspect=prompt(desk,'Inspect business',d.name,function(player) onPrompt(player,index,d.id) end)
			local workstation=part(b,'OperationsTerminal',Vector3.new(6,4,3),origin+Vector3.new(20,3,-7),teal,Enum.Material.Metal)
			sign(b,origin+Vector3.new(20,7,-7),Vector3.new(13,3,0.5),'OPERATIONS',teal)
			prompt(workstation,'Run operation',d.name,function(player) if onOperation then onOperation(player,index,d.id,workstation) end end)
			plot.buildings[d.id]={wall=wall,status=status,accent=accent,prompt=inspect,origin=origin,model=b,workstation=workstation}
		end
	end
	return plaza
end
function World.assign(index,player)
	local p=World.plots[index];p.owner=player;player.RespawnLocation=p.spawn
	p.label.Text=string.upper(player.DisplayName)..' · DISTRICT '..index
end
function World.refresh(index,profile)
	local p=World.plots[index]
	for _,d in Config.Businesses do
		local b=p.buildings[d.id];local level=profile and profile.businesses[d.id]
		b.wall.Color=if level~=nil then cream else Color3.fromRGB(151,158,158)
		b.status.Text=if level~=nil then 'OWNED · '..level..'/'..#d.projects..' IMPROVEMENTS' else 'FOR SALE · $'..d.cost
		b.prompt.ActionText=if level~=nil then 'Review improvements' else 'Inspect acquisition'
		for j=1,#d.projects do
			local marker=b.model:FindFirstChild('Improvement'..j)
			if level~=nil and level>=j then
				if not marker then part(b.model,'Improvement'..j,Vector3.new(4,2,4),b.origin+Vector3.new(j*7-14,21,15),gold,Enum.Material.Neon) end
			elseif marker then marker:Destroy() end
		end
	end
end
function World.release(index)
	local p=World.plots[index];p.owner=nil;p.label.Text='DISTRICT '..index..' · AVAILABLE';World.refresh(index,nil)
end
function World.teleport(index,character,id)
	local plot=World.plots[index]
	local destination=if id and plot.buildings[id] then plot.buildings[id].origin+Vector3.new(0,5,-35) else plot.origin+Vector3.new(0,5,-130)
	character:PivotTo(CFrame.lookAt(destination,destination+Vector3.new(0,0,20)))
end
return World
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="13">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="14">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript" referent="15">
        <Properties>
          <string name="Name">Main</string>
          <string name="Source"><![CDATA[--!strict
local Players=game:GetService('Players')
local RS=game:GetService('ReplicatedStorage')
local UIS=game:GetService('UserInputService')
local GuiService=game:GetService('GuiService')
local player=Players.LocalPlayer
local StarterGui=game:GetService('StarterGui')
StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.PlayerList,false)
pcall(function() StarterGui:SetCore('ChatActive',false) end)
player.CameraMinZoomDistance=14
player.CameraMaxZoomDistance=120
local modules=RS:WaitForChild('CUPEC')
local Config=require(modules:WaitForChild('Config'))
local Cases=require(modules:WaitForChild('CaseStudies'))
local Format=require(modules:WaitForChild('Format')) -- retained from the MIT upstream
local remote=modules:WaitForChild('Portfolio')
local navy=Color3.fromRGB(23,34,53)
local panel=Color3.fromRGB(32,45,65)
local cream=Color3.fromRGB(246,238,225)
local muted=Color3.fromRGB(178,190,199)
local rose=Color3.fromRGB(232,154,170)
local gold=Color3.fromRGB(229,190,126)
local teal=Color3.fromRGB(117,210,180)
local state=nil
local selected='factory'
local collapsed=UIS.TouchEnabled
local showingCase=false
local toastUntil=0
local function create(class,parent,props)
	local instance=Instance.new(class)
	for k,v in props do instance[k]=v end
	instance.Parent=parent
	return instance
end
local function corner(p,r) create('UICorner',p,{CornerRadius=UDim.new(0,r or 12)}) end
local function label(p,text,pos,size,fontSize,color)
	return create('TextLabel',p,{Text=text,Position=pos,Size=size,TextSize=fontSize or 15,Font=Enum.Font.GothamMedium,
		TextColor3=color or cream,TextXAlignment=Enum.TextXAlignment.Left,BackgroundTransparency=1,TextWrapped=true})
end
local function button(p,text,pos,size,color)
	local b=create('TextButton',p,{Text=text,Position=pos,Size=size,BackgroundColor3=color or rose,
		TextColor3=navy,Font=Enum.Font.GothamBold,TextSize=14,BorderSizePixel=0,AutoButtonColor=true,TextWrapped=true})
	corner(b,9)
	return b
end
local function money(n) return '$'..Format.number(n or 0) end
local function baht(n) return if n==nil then 'Unavailable' else 'THB '..Format.number(n) end
local gui=create('ScreenGui',player:WaitForChild('PlayerGui'),{Name='CUPEC',ResetOnSpawn=false,ZIndexBehavior=Enum.ZIndexBehavior.Sibling,IgnoreGuiInset=false})
local top=create('Frame',gui,{Name='PortfolioHeader',Size=UDim2.new(1,-24,0,90),Position=UDim2.fromOffset(12,10),BackgroundColor3=navy,BorderSizePixel=0})
corner(top)
label(top,'CUPEC',UDim2.fromOffset(16,8),UDim2.fromOffset(100,28),24,rose).Font=Enum.Font.GothamBlack
local strap=label(top,'BUSINESS CITY',UDim2.fromOffset(122,12),UDim2.new(1,-280,0,22),12,muted)
local cash=label(top,'Connecting…',UDim2.fromOffset(16,43),UDim2.fromOffset(230,30),25,cream)
local income=label(top,'',UDim2.fromOffset(246,44),UDim2.fromOffset(230,28),17,teal)
local toggle=button(top,'PORTFOLIO',UDim2.new(1,-133,0,16),UDim2.fromOffset(118,44),cream)
toggle.Name='TogglePortfolio'
local market=label(top,'',UDim2.new(1,-348,0,66),UDim2.fromOffset(330,18),12,gold)
market.TextXAlignment=Enum.TextXAlignment.Right

local drawer=create('Frame',gui,{Name='DealRoom',AnchorPoint=Vector2.new(0,1),Position=UDim2.new(0,12,1,-12),Size=UDim2.fromOffset(390,530),BackgroundColor3=navy,BorderSizePixel=0})
corner(drawer)
drawer.Visible=not collapsed
local scale=create('UIScale',drawer,{Scale=1})
local content=create('ScrollingFrame',drawer,{Name='Content',Position=UDim2.fromOffset(0,0),Size=UDim2.fromOffset(390,388),CanvasSize=UDim2.fromOffset(390,384),ScrollingDirection=Enum.ScrollingDirection.Y,ScrollBarThickness=4,ScrollBarImageColor3=rose,BackgroundTransparency=1,BorderSizePixel=0,ClipsDescendants=true})
label(content,'YOUR NEXT MOVE',UDim2.fromOffset(18,12),UDim2.fromOffset(300,22),12,rose)
local tabs={}
local tabStrip=create('ScrollingFrame',content,{Name='BusinessTabs',Position=UDim2.fromOffset(18,42),Size=UDim2.fromOffset(354,48),CanvasSize=UDim2.fromOffset(#Config.Businesses*126,42),BackgroundTransparency=1,BorderSizePixel=0,ScrollBarThickness=3,ScrollingDirection=Enum.ScrollingDirection.X})
for i,d in Config.Businesses do
	local tab=button(tabStrip,tostring(i)..'  '..d.name,UDim2.fromOffset((i-1)*126,0),UDim2.fromOffset(120,40),panel)
	tab.TextColor3=cream
	tab.TextWrapped=true;tab.TextSize=12
	tab.ClipsDescendants=true
	tab.TextScaled=true
	create('UITextSizeConstraint',tab,{MinTextSize=9,MaxTextSize=12})
	tab.Name='Tab_'..d.id
	tabs[d.id]=tab
	tab.Activated:Connect(function() selected=d.id; if state then state.selected=d.id end end)
end
local sector=label(content,'',UDim2.fromOffset(18,99),UDim2.fromOffset(350,18),11,rose)
local name=label(content,'Loading your portfolio…',UDim2.fromOffset(18,121),UDim2.fromOffset(350,34),26)
name.Font=Enum.Font.GothamBold
name.TextScaled=true
create('UITextSizeConstraint',name,{MinTextSize=18,MaxTextSize=26})
local story=label(content,'The server is preparing your district.',UDim2.fromOffset(18,162),UDim2.fromOffset(350,54),14,muted)
local metrics=create('Frame',content,{Position=UDim2.fromOffset(18,229),Size=UDim2.fromOffset(354,66),BackgroundColor3=panel,BorderSizePixel=0})
corner(metrics,9)
local metricA=label(metrics,'',UDim2.fromOffset(12,6),UDim2.fromOffset(160,49),14)
local metricB=label(metrics,'',UDim2.fromOffset(178,6),UDim2.fromOffset(164,49),14,teal)
local project=label(content,'',UDim2.fromOffset(18,309),UDim2.fromOffset(350,43),16,cream)
local detail=label(content,'',UDim2.fromOffset(18,353),UDim2.fromOffset(350,26),13,muted)
local action=button(drawer,'Connecting…',UDim2.fromOffset(18,389),UDim2.fromOffset(354,48),rose)
action.Name='Action'
local travel=button(drawer,'VISIT BUSINESS',UDim2.fromOffset(18,445),UDim2.fromOffset(173,36),cream)
local caseButton=button(drawer,'DBD CASE DATA',UDim2.fromOffset(199,445),UDim2.fromOffset(173,36),gold)
caseButton.Name='CaseData'
travel.Name='VisitBusiness'
local footer=label(drawer,'',UDim2.fromOffset(18,487),UDim2.fromOffset(354,32),10,muted)
local toast=create('Frame',gui,{Name='Notice',AnchorPoint=Vector2.new(0.5,0),Position=UDim2.new(0.5,0,0,110),Size=UDim2.new(0.7,0,0,48),BackgroundColor3=navy,BorderSizePixel=0,Visible=false})
corner(toast)
local toastText=label(toast,'',UDim2.fromOffset(12,4),UDim2.new(1,-24,1,-8),14,cream)
toastText.TextXAlignment=Enum.TextXAlignment.Center
local hint=label(gui,'WASD to explore · E at desks / operations · P for portfolio',UDim2.new(1,-490,1,-45),UDim2.fromOffset(470,28),13,cream)
hint.TextXAlignment=Enum.TextXAlignment.Right

local function currentDef()
	for _,d in Config.Businesses do if d.id==selected then return d end end
	return Config.Businesses[1]
end
local function refresh()
	if not state then return end
	local d=currentDef()
	local level=state.businesses[d.id]
	cash.Text=money(state.cash)
	income.Text='+'..money(state.rate)..' / sec'
	market.Text=state.market..' · '..state.nextMarket..'s'
	sector.Text=d.sector
	name.Text=d.name
	story.Text=d.story
	metricA.Text=if level==nil then 'GAME ASKING PRICE\n'..money(d.cost) else 'GAME ASSET VALUE\n'..money(d.assets)
	metricB.Text=if level==nil then ('GAME PRICE / ASSETS\n%.2fx'):format(d.cost/d.assets) else 'IMPROVEMENTS\n'..level..' / '..#d.projects
	local nextProject=level~=nil and d.projects[level+1] or nil
	local cost=d.cost
	local available=true
	if level==nil then
		project.Text='Acquire the business'
		detail.Text='Base cash flow: +'..money(d.income)..' / sec'
		if d.requires and state.businesses[d.requires]==nil then available=false end
		action.Text=if available then 'ACQUIRE · '..money(d.cost) else 'ACQUIRE THE PREVIOUS BUSINESS FIRST'
	elseif nextProject then
		cost=nextProject.cost
		project.Text=nextProject.name
		detail.Text=nextProject.detail
		action.Text='FUND IMPROVEMENT · '..money(cost)
	else
		available=false
		project.Text='Business fully improved'
		detail.Text='Visit the operations terminal inside for active cash-flow bonuses.'
		action.Text='OPERATING AT FULL POTENTIAL'
	end
	local affordable=available and state.cash>=cost
	action.BackgroundColor3=if affordable then rose else panel
	action.TextColor3=if affordable then navy else muted
	local owned=0
	for _ in state.businesses do owned+=1 end
	footer.Text=state.saveMode..' · District '..state.slot..'\nFICTIONAL GAME CASH · '..owned..' / '..#Config.Businesses..' businesses · '..(state.operations or 0)..' operations'
	local case=Cases[d.id]
	if showingCase and case then
		sector.Text='HISTORICAL DBD CASE · FY '..case.financial_year
		story.Text='Source company: '..case.source_name_th
		metricA.Text='REPORTED ANNUAL REVENUE\n'..baht(case.reported.revenue)
		metricB.Text='REPORTED TOTAL ASSETS\n'..baht(case.reported.assets)
		project.Text='Net profit: '..baht(case.reported.net_profit)..'\nEquity: '..baht(case.reported.equity)
		detail.Text='DBD registration: '..case.registration_id
		action.Text='BACK TO GAMEPLAY'
		action.BackgroundColor3=cream;action.TextColor3=navy
		footer.Text='Saved public summary · checked '..case.checked_at..'\nName, purchase price and upgrades in gameplay are fictional.'
	end
	caseButton.Text=if showingCase then 'GAME VIEW' else 'DBD CASE DATA'
	for id,tab in tabs do
		tab.BackgroundColor3=if id==selected then cream else panel
		tab.TextColor3=if id==selected then navy else muted
	end
end

action.Activated:Connect(function()
	if showingCase then showingCase=false;refresh();return end
	if state then remote:FireServer(if state.businesses[selected]==nil then 'buy' else 'improve',selected) end
end)
caseButton.Activated:Connect(function() showingCase=not showingCase;refresh() end)
travel.Activated:Connect(function() if state then remote:FireServer('travel',selected);collapsed=true;drawer.Visible=false end end)
toggle.Activated:Connect(function() collapsed=not collapsed; drawer.Visible=not collapsed end)
UIS.InputBegan:Connect(function(input,processed)
	if not processed and input.KeyCode==Enum.KeyCode.P then collapsed=not collapsed; drawer.Visible=not collapsed end
end)
remote.OnClientEvent:Connect(function(snapshot)
	state=snapshot
	if snapshot.selected then
		selected=snapshot.selected
		if not UIS.TouchEnabled or not (snapshot.message and snapshot.message:match('^Welcome%.')) then collapsed=false;drawer.Visible=true end
	end
	if snapshot.message then
		toastText.Text=snapshot.message
		toast.Visible=true
		toastUntil=os.clock()+5
	end
	refresh()
end)
local function resize()
	local camera=workspace.CurrentCamera
	if not camera then return end
	local size=camera.ViewportSize
	local inset=GuiService:GetGuiInset()
	scale.Scale=math.min(1,(size.X-24)/390)
	local small=size.X<700
	local headerHeight=if small then 118 else 90
	top.Size=UDim2.new(1,-24,0,headerHeight)
	cash.Position=UDim2.fromOffset(16,if small then 53 else 43)
	local cardHeight=math.min(530,math.max(190,(size.Y-inset.Y-headerHeight-45)/scale.Scale))
	drawer.Size=UDim2.fromOffset(390,cardHeight)
	local bodyHeight=cardHeight-142
	content.Size=UDim2.fromOffset(390,bodyHeight)
	action.Position=UDim2.fromOffset(18,bodyHeight+5)
	travel.Position=UDim2.fromOffset(18,bodyHeight+61)
	caseButton.Position=UDim2.fromOffset(199,bodyHeight+61)
	footer.Position=UDim2.fromOffset(18,bodyHeight+103)
	toast.Position=UDim2.new(0.5,0,0,headerHeight+20)
	strap.Visible=not small
	income.Position=if small then UDim2.fromOffset(16,83) else UDim2.fromOffset(246,44)
	income.TextSize=if small then 14 else 17
	market.Visible=not small
	hint.Visible=not UIS.TouchEnabled and size.X>900
end
task.spawn(function()
	while gui.Parent do
		refresh(); resize()
		if toast.Visible and os.clock()>toastUntil then toast.Visible=false end
		if not state then remote:FireServer('sync') end
		task.wait(0.3)
	end
end)
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="Workspace" referent="16">
    <Properties>
      <string name="Name">Workspace</string>
      <float name="Gravity">196.2</float>
      <bool name="NeedsPivotMigration">false</bool>
    </Properties>
  </Item>
</roblox>